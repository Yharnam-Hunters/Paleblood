get_filename_component(PB_BRIDGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_executable(test_capture_stack "${PB_BRIDGE_ROOT}/test/test_capture_stack.c" "${PB_BRIDGE_ROOT}/runtime/capture_stack.c")
target_include_directories(test_capture_stack PRIVATE "${PB_BRIDGE_ROOT}/runtime/include")
add_test(NAME capture_stack COMMAND test_capture_stack)
set_tests_properties(capture_stack PROPERTIES TIMEOUT 15)
if(CMAKE_OSX_ARCHITECTURES)
    set(PB_BRIDGE_ARCH "${CMAKE_OSX_ARCHITECTURES}")
else()
    set(PB_BRIDGE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(PB_BRIDGE_ARCH MATCHES "^(x86_64|AMD64|amd64)$")
    add_executable(test_capture_observe_entry "${PB_BRIDGE_ROOT}/test/test_capture_observe_entry.c"
        "${PB_BRIDGE_ROOT}/runtime/capture_entry.S" "${PB_BRIDGE_ROOT}/runtime/observe_entry.S")
    add_test(NAME capture_observe_entry COMMAND test_capture_observe_entry)
    add_executable(test_probe_bridge "${PB_BRIDGE_ROOT}/test/test_probe_bridge.c" "${PB_BRIDGE_ROOT}/runtime/memory.c")
    target_include_directories(test_probe_bridge PRIVATE "${PB_BRIDGE_ROOT}/runtime/include")
    find_package(Threads REQUIRED)
    target_link_libraries(test_probe_bridge PRIVATE Threads::Threads)
    add_test(NAME probe_bridge COMMAND test_probe_bridge)
    set_tests_properties(capture_observe_entry probe_bridge PROPERTIES TIMEOUT 15)
endif()
if(TARGET test_observe_hooks)
    set_tests_properties(observe_hooks PROPERTIES TIMEOUT 15)
endif()

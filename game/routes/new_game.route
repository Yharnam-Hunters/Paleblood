# Title menu -> (offline notices) -> New Game -> brightness -> controls -> opening cutscene -> ?
wait "play" 120
# Cross confirms the highlighted entry, each network notice, then New Game.
wait "Adjust slider" 60 cross every=4
+2 down
+1 cross
# First-run controls setup: Next is the 7th entry.
wait "Change camera" 30
+1 down
+0.6 down
+0.6 down
+0.6 down
+0.6 down
+0.6 down
+0.5 cross
# Opening cutscene: try to skip it.
+12 shot
+1 options
+2 shot
+1 cross
# Character creation ("Contract"): the name box opens on its own.
wait "Contract" 30
+3 shot
+1 type=Hunter key=Return
+2 shot
# Finish is the last entry: up wraps to it (if not, the shot shows where the cursor went).
+1 up
+1 cross
# "Finalise contract?" defaults to NO.
wait "Finalise" 15
+1 left
+1 cross
# Transfusion cutscene: skip once its first subtitle is up.
wait "signed" 60
+1 options
+1.5 shot
+0.5 cross
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
+8 shot
